{
  "name": "prenium-dtf-frontend",
  "private": true,
  "scripts": {
    "build:assets": "npm run copy:vendor && npm run build:css",
    "build:css": "npm run build:css:app && npm run build:css:marketing && npm run build:css:portal:all && npm run build:css:studio",
    "build:css:app": "tailwindcss -i ./static_src/css/input.css -o ./static_src/css/app.css --minify",
    "build:css:marketing": "tailwindcss -c ./static_src/css/entries/tailwind.surface.config.js -i ./static_src/css/entries/marketing.css -o ./static_src/css/marketing.css --minify",
    "build:css:portal:all": "npm run build:css:portal-core && npm run build:css:portal-client && npm run build:css:portal-staff && npm run build:css:prospect && npm run build:css:portal",
    "build:css:portal-core": "tailwindcss -c ./static_src/css/entries/tailwind.surface.config.js -i ./static_src/css/entries/portal-core.css -o ./static_src/css/portal-core.css --minify",
    "build:css:portal-client": "tailwindcss -c ./static_src/css/entries/tailwind.surface.config.js -i ./static_src/css/entries/portal-client.css -o ./static_src/css/portal-client.css --minify",
    "build:css:portal-staff": "tailwindcss -c ./static_src/css/entries/tailwind.surface.config.js -i ./static_src/css/entries/portal-staff.css -o ./static_src/css/portal-staff.css --minify",
    "build:css:prospect": "tailwindcss -c ./static_src/css/entries/tailwind.surface.config.js -i ./static_src/css/entries/prospect.css -o ./static_src/css/prospect.css --minify",
    "build:css:portal": "tailwindcss -c ./static_src/css/entries/tailwind.surface.config.js -i ./static_src/css/entries/portal.css -o ./static_src/css/portal.css --minify",
    "build:css:studio": "tailwindcss -c ./static_src/css/entries/tailwind.surface.config.js -i ./static_src/css/entries/studio.css -o ./static_src/css/studio.css --minify",
    "copy:vendor": "node ./scripts/copy-vendor.mjs",
    "watch:css": "npm run build:css && tailwindcss -i ./static_src/css/input.css -o ./static_src/css/app.css --watch",
    "watch:css:marketing": "tailwindcss -c ./static_src/css/entries/tailwind.surface.config.js -i ./static_src/css/entries/marketing.css -o ./static_src/css/marketing.css --watch",
    "watch:css:portal": "tailwindcss -c ./static_src/css/entries/tailwind.surface.config.js -i ./static_src/css/entries/portal.css -o ./static_src/css/portal.css --watch",
    "watch:css:studio": "tailwindcss -c ./static_src/css/entries/tailwind.surface.config.js -i ./static_src/css/entries/studio.css -o ./static_src/css/studio.css --watch",
    "collectstatic:docker": "cd .. && docker compose exec -T web sh -c 'cd /app/backend && python manage.py collectstatic --noinput'",
    "build:css:docker": "npm run build:css && npm run collectstatic:docker"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "alpinejs": "3.14.3",
    "autoprefixer": "^10.4.20",
    "daisyui": "^4.12.14",
    "htmx.org": "1.9.12",
    "pdfjs-dist": "^6.2.108",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.17"
  }
}
